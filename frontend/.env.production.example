# Production — Vercel + Cloudflare DNS + Railway API
# Domains: pms.stayatumalila.com, booking.stayatumalila.com (both on one Vercel project)

VITE_TENANT_SLUG=umalila

# Railway public URL (Settings → Networking) or https://api.stayatumalila.com via Cloudflare
VITE_API_BASE_URL=https://YOUR-APP.up.railway.app

# Optional: force a surface when hostname detection is not enough (admin | booking | all)
# VITE_APP_HOST_MODE=all
